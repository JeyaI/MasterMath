# Template for ~/.config/mathshorts.env (outside the repo; chmod 600). Never commit real values.
# The file is sourced as shell: no spaces around =, no quotes needed.
# Discord IDs need Developer Mode on (Settings > Advanced) to show "Copy ID".

# Claude jobs: a one-year token from `claude setup-token`. Leave ANTHROPIC_API_KEY unset.
CLAUDE_CODE_OAUTH_TOKEN=

# Discord (#28). Bot token: Developer Portal > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# Your Discord account: right-click your name > Copy User ID. The bot acts only on this user.
MS_DISCORD_USER_ID=
# The drafts channel: right-click it > Copy Channel ID.
MS_DISCORD_CHANNEL_ID=
